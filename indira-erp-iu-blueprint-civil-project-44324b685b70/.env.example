VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# UMS API. Leave VITE_UMS_BASE_URL blank until the UMS API is available —
# the UMS Employees tab will show empty rather than displaying stale mock data.
VITE_UMS_BASE_URL=

# ---- Supabase Edge Function secrets (set via `supabase secrets set …`, NOT in this file) ----
